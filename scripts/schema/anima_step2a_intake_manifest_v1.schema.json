          }
        },
        "selection_ready": {
          "type": "boolean"
        },
        "execution_authorized": {
          "const": false
        },
        "hold_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selection_ready": {
                "const": true
              }
            },
            "required": [
              "selection_ready"
            ]
          },
          "then": {
            "properties": {
              "inventory_status": {
                "const": "COMPLETE"
              },
              "selected_windows": {
                "type": "array",
                "minItems": 1
              },
              "selected_rows": {
                "type": "integer",
                "minimum": 1
              },
              "touched_rows_upper_bound": {
                "type": "integer",
                "minimum": 1
              },
              "planned_payload_requests": {
                "type": "integer",
                "minimum": 1
              },
              "planned_payload_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "planned_ranges": {
                "type": "array",
                "minItems": 1
              },
              "hold_reasons": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "selected_windows": {
                "type": "array",
                "maxItems": 0
              },
              "selected_rows": {
                "const": 0
              },
              "touched_rows_upper_bound": {
                "const": 0
              },
              "planned_payload_requests": {
                "const": 0
              },
              "planned_payload_bytes": {
                "const": 0
              },
              "planned_ranges": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_group_index",
        "row_index_in_group",
        "anchor_page_ordinal",
        "selection_key_sha256"
      ],
      "properties": {
        "row_group_index": {
          "type": "integer",
          "minimum": 0
        },
        "row_index_in_group": {
          "type": "integer",
          "minimum": 0
        },
        "anchor_page_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "selection_key_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "projectedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_string",
        "tag_string_general",
