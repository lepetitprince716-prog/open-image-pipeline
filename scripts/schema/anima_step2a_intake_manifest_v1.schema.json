{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loramake.local/schema/anima_step2a_intake_manifest_v1.schema.json",
  "title": "Anima Step 2a draft input-semantics manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "operation",
    "status",
    "training_ready",
    "manifest_id",
    "source_binding",
    "parents",
    "limits",
    "selection",
    "records",
    "ledger",
    "gate",
    "activity"
  ],
  "properties": {
    "schema": {
      "const": "anima-step2a-intake-manifest-v1"
    },
    "contract_version": {
      "const": "anima-step2a-input-policy-v2-draft"
    },
    "operation": {
      "enum": [
        "sample_plan",
        "derive_provenance",
        "ledger_join"
      ]
    },
    "status": {
      "const": "DRAFT_G1_HOLD"
    },
    "training_ready": {
      "const": false
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^anima-step2a-intake-[0-9a-f]{24}$"
    },
    "source_binding": {
      "$ref": "#/$defs/sourceBinding"
    },
    "parents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parent"
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "selection": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/selection"
        }
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "ledger": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ledgerSummary"
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "g1",
        "reasons"
      ],
      "properties": {
        "g1": {
          "const": "HOLD"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "activity": {
      "$ref": "#/$defs/activity"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "sample_plan"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "selection": {
            "$ref": "#/$defs/selection"
          },
          "records": {
            "type": "array",
            "maxItems": 0
          },
          "ledger": {
            "type": "null"
          },
          "parents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "selection": {
                  "type": "object",
                  "properties": {
                    "inventory_status": {
                      "const": "COMPLETE"
                    }
                  },
                  "required": [
                    "inventory_status"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "parents": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": {
                        "role": {
                          "const": "page_index_inventory"
                        },
                        "semantic_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "role": {
                          "const": "page_index_probe"
                        },
                        "semantic_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "role": {
                          "const": "raw_fixed_footer"
                        },
                        "semantic_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "role": {
                          "const": "offset_index_evidence"
                        },
                        "semantic_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ],
                  "items": false
                }
              }
            },
            "else": {
              "properties": {
                "parents": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": {
                        "role": {
                          "const": "page_index_inventory"
                        },
                        "semantic_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ],
                  "items": false
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "derive_provenance"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "selection": {
            "allOf": [
              {
                "$ref": "#/$defs/selection"
              },
              {
                "type": "object",
                "properties": {
                  "selection_ready": {
                    "const": true
                  }
                }
              }
            ]
          },
          "records": {
            "type": "array",
            "minItems": 1
          },
          "ledger": {
            "type": "null"
          },
          "parents": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "selection_manifest"
                  },
                  "semantic_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "bounded_projected_rows"
                  },
                  "semantic_id": {
                    "type": "null"
                  }
                }
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "ledger_join"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "selection": {
            "allOf": [
              {
                "$ref": "#/$defs/selection"
              },
              {
                "type": "object",
                "properties": {
                  "selection_ready": {
                    "const": true
                  }
                }
              }
            ]
          },
          "records": {
            "type": "array",
            "minItems": 1
          },
          "ledger": {
            "$ref": "#/$defs/ledgerSummary"
          },
          "parents": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "derived_provenance_manifest"
                  },
                  "semantic_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "removal_ledger"
                  },
                  "semantic_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "ledger_coverage_evidence"
                  },
                  "semantic_id": {
                    "type": "null"
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "trusted_removal_ledger_head"
                  },
                  "semantic_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "previous_removal_snapshot"
                  },
                  "semantic_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ],
            "items": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "ledger": {
                  "type": "object",
                  "properties": {
                    "coverage_mode": {
                      "const": "delta_only"
                    }
                  },
                  "required": [
                    "coverage_mode"
                  ]
                }
              },
              "required": [
                "ledger"
              ]
            },
            "then": {
              "properties": {
                "records": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ledger_status": {
                        "not": {
                          "const": "NOT_OPTED_OUT"
                        }
                      }
                    },
                    "required": [
                      "ledger_status"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "ledger": {
                  "type": "object",
                  "properties": {
                    "coverage_mode": {
                      "const": "authoritative_complete_snapshot"
                    }
                  },
                  "required": [
                    "coverage_mode"
                  ]
                }
              },
              "required": [
                "ledger"
              ]
            },
            "then": {
              "properties": {
                "records": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ledger_status": {
                        "not": {
                          "const": "HOLD_OPT_OUT_UNKNOWN"
                        }
                      }
                    },
                    "required": [
                      "ledger_status"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        {
          "type": "string",
          "pattern": "^(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_revision",
        "filename",
        "size_bytes",
        "footer_sha256",
        "footer_plan",
        "prior_policy_approval",
        "removal_ledger_trust",
        "input_policy_version",
        "source_binding_sha256"
      ],
      "properties": {
        "source": {
          "const": "deepghs/danbooru2024-webp-4Mpixel"
        },
        "source_revision": {
          "const": "60ca7e02a844bccbe6c8344d1a18b7ea280b787f"
        },
        "filename": {
          "const": "metadata.parquet"
