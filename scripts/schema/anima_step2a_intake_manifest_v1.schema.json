        "selection_key_sha256"
      ],
      "properties": {
        "row_group_index": {
          "type": "integer",
          "minimum": 0
        },
        "anchor_page_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "first_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "selection_key_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "plannedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_group_index",
        "column",
        "kind",
        "page_ordinal",
        "start",
        "end",
        "bytes"
      ],
      "properties": {
        "row_group_index": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "enum": [
            "score",
            "source",
            "md5",
            "tag_string",
            "tag_string_general",
            "rating",
            "id"
          ]
        },
        "kind": {
          "enum": [
            "data_page",
            "column_prefix_prerequisite"
          ]
        },
        "page_ordinal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_version",
        "selection_salt",
        "inventory_status",
        "anchor_column",
        "candidate_count",
        "eligible_candidate_count",
        "selected_windows",
        "selected_rows",
        "touched_rows_upper_bound",
        "planned_payload_requests",
        "planned_payload_bytes",
        "planned_ranges",
        "selection_ready",
        "execution_authorized",
        "hold_reasons"
      ],
      "properties": {
        "algorithm_version": {
          "const": "sha256-page-bundle-rank-v1"
        },
        "selection_salt": {
          "type": "string",
          "minLength": 1
        },
        "inventory_status": {
          "enum": [
            "COMPLETE",
            "OFFSET_INDEX_UNAVAILABLE",
            "INCOMPLETE",
            "UNKNOWN"
          ]
        },
        "anchor_column": {
          "const": "id"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "selected_windows": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/window"
          }
        },
        "selected_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "touched_rows_upper_bound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "planned_payload_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "planned_payload_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "planned_ranges": {
          "type": "array",
          "maxItems": 4096,
          "items": {
