              "const": "388922c14c093093c4f10ea80cfde6789d40dc840af31321ac9154b38cf60cc2"
            },
            "snapshot_path": {
              "const": "docs/lora_training/anima_step2a/COMPLIANCE_PROPOSAL_APPROVAL_SNAPSHOT_2026-07-18.md"
