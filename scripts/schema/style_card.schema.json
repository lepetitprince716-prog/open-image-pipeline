{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loramake.style-card/v1",
  "title": "Style card",
  "description": "One visual style with its per-line realizations. Realizations reference existing assets (NovelAI artist cards, local LoRA catalog ids, t2i catalog items, Civitai AIR URNs) and never copy them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "revision", "family", "display_name", "description", "priority", "evidence", "lines", "realizations", "gaps"],
  "properties": {
    "schema": {"const": "loramake.style-card/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "family": {"enum": ["anime", "media", "photo", "digital", "theme", "house"]},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "priority": {"enum": ["P1", "P2", "P3", "house"]},
    "taste_note": {"type": "string"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "date", "ref"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "ref": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "exemplars": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "lines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["illustrious", "anima", "nai", "krea2", "civitai"]}
    },
    "realizations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "illustrious": {"$ref": "#/$defs/realization_list"},
        "anima": {"$ref": "#/$defs/realization_list"},
        "nai": {"$ref": "#/$defs/realization_list"},
        "krea2": {"$ref": "#/$defs/realization_list"},
        "civitai": {"$ref": "#/$defs/realization_list"}
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line", "path"],
        "properties": {
          "line": {"enum": ["illustrious", "anima", "nai", "krea2", "civitai"]},
          "path": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "realization_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/realization"}
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {"type": "string"},
        "ref": {"type": "string"},
        "model": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "lora_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "weight"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "weight": {"type": "number"},
        "ref": {"type": "string"},
        "trigger": {"type": "string"}
      }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "tier"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "suffix": {"type": "string"},
        "kind": {"enum": ["nai_card", "lora", "t2i_item", "prompt", "civitai_air", "caption", "lora_stack"]},
        "tier": {"enum": ["verified", "candidate", "blocked"]},
        "note": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence_ref"},
        "ref": {"type": "string"},
        "model": {"type": "string"},
        "prompt": {"type": "string"},
        "negative": {"type": "string"},
        "weight": {"type": "number"},
        "base_pin": {"type": ["string", "null"]},
        "post_fx": {"type": ["string", "null"]},
        "sampler": {"type": "object"},
        "air": {"type": "string", "pattern": "^urn:air:[a-z0-9]+:lora:civitai:[0-9]+@[0-9]+$"},
        "model_id": {"type": "integer"},
        "version_id": {"type": "integer"},
        "base_model": {"type": "string"},
        "trigger": {"type": "string"},
        "caption": {"type": "string"},
        "loras": {"type": "array", "items": {"$ref": "#/$defs/lora_entry"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "nai_card"}}}, "then": {"required": ["ref"]}},
        {"if": {"properties": {"kind": {"const": "lora"}}}, "then": {"required": ["ref", "weight"]}},
        {"if": {"properties": {"kind": {"const": "t2i_item"}}}, "then": {"required": ["ref"]}},
        {"if": {"properties": {"kind": {"const": "prompt"}}}, "then": {"required": ["prompt"]}},
        {"if": {"properties": {"kind": {"const": "civitai_air"}}}, "then": {"required": ["air", "model_id", "version_id", "base_model", "weight"]}},
        {"if": {"properties": {"kind": {"const": "caption"}}}, "then": {"required": ["caption"]}},
        {"if": {"properties": {"kind": {"const": "lora_stack"}}}, "then": {"required": ["loras"]}}
      ]
    }
  }
}
