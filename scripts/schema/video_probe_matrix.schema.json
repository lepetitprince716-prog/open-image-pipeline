{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loramake-video-probe-matrix-v1",
  "title": "loramake video probe matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "arms"],
  "properties": {
    "schema": {"const": "loramake-video-probe-matrix-v1"},
    "description": {"type": "string"},
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "prompt": {"type": "string", "minLength": 1},
          "res": {"type": "string", "pattern": "^[0-9]+x[0-9]+$"},
          "pos_suffix": {"type": "string"},
          "negative": {"type": "string"},
          "anime_lora": {"type": ["string", "null"]},
          "length": {
            "type": "integer",
            "enum": [5, 9, 13, 17, 21, 25, 29, 33, 37, 41, 45, 49, 53, 57, 61, 65, 69, 73, 77, 81]
          },
          "seed": {"type": "integer"},
          "identity_frames": {"type": "integer", "minimum": 2, "maximum": 81},
          "expected": {
            "type": "object",
            "required": ["subject_motion", "camera_motion"],
            "properties": {
              "subject_motion": {"type": "string", "minLength": 1},
              "camera_motion": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
